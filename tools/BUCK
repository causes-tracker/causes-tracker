load(":defs.bzl", "cached_check", "cached_http_archive", "shellcheck_package", "tree_tool")

export_file(
    name = "agent_action_guard_src",
    src = "agent_action_guard.py",
)

command_alias(
    name = "agent_action_guard",
    exe = "//third_party/python:py",
    args = ["$(location :agent_action_guard_src)"],
    visibility = ["PUBLIC"],
)

cached_check(
    name = "py_version_check",
    exe = "//third_party/python:py",
    srcs = [
        "py_version_check.py",
        "//third_party/python:pin",
    ],
)

cached_http_archive(
    name = "shellcheck_archive",
    sha256 = "8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198",
    size_bytes = 2559196,
    strip_components = 1,
    urls = ["https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz"],
)

tree_tool(
    name = "shellcheck",
    path = "shellcheck",
    tree = ":shellcheck_archive",
    visibility = ["PUBLIC"],
)

export_file(
    name = "shellcheck_check.sh",
    visibility = ["PUBLIC"],
)

export_file(
    name = "install_release.shlib",
    # Reference mode keeps the source path, which is where the sourcing
    # scripts' `$(dirname "$0")/..` resolves.
    mode = "reference",
    visibility = [
        "//tools/crun:",
        "//tools/nativelink:",
    ],
)

shellcheck_package()
