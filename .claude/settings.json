{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/agent_action_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(jj git push:*)",
            "command": "bash tools/check.sh agent //... || printf '{\"continue\":false,\"stopReason\":\"Pre-push gate failed — fix the issue before pushing.\"}'",
            "timeout": 300,
            "statusMessage": "Running pre-push gates (agent mode)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/check.sh agent //... || printf '{\"decision\":\"block\",\"reason\":\"End-of-turn gate failed — fix the issue before finishing.\"}'",
            "timeout": 300,
            "statusMessage": "Running end-of-turn gates (agent mode)..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh run:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(bazel clean:*)",
      "Bash(bazel test:*)",
      "Bash(jj:*)",
      "Bash(jj git fetch:*)",
      "Bash(jj rebase -r mutable:*)",
      "Bash(jj git push --all:*)",
      "Bash(jj rebase:*)",
      "Bash(bazel build:*)",
      "Bash(tar tzf:*)",
      "Bash(jj log:*)",
      "WebSearch",
      "Bash(bazel run:*)",
      "Bash(bazel sync:*)",
      "Bash(bazel fetch:*)",
      "Bash(bazel query:*)",
      "Bash(bazel mod:*)",
      "Bash(bazel help:*)",
      "Bash(bash tools/check.sh agent //...)",
      "Bash(bash tools/check.sh stack //...)",
      "Bash(bash tools/check.sh ci //...)"
    ],
    "deny": [
      "Read(~/.aws/credentials)",
      "Bash(git:*)"
    ]
  }
}
