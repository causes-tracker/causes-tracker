load("//build:rust.bzl", "rust_binary", "rust_test")
load("//tools/lint:format_check.bzl", "format_srcs")

rust_binary(
    name = "ci_health",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//lib/rust/causes_crypto",
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:clap",
        "@crates//:octocrab",
        "@crates//:reqwest",
        "@crates//:safelog",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:zip",
    ],
)

rust_test(
    name = "ci_health_test",
    crate = ":ci_health",
    deps = [
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:wiremock",
    ],
)

format_srcs()
