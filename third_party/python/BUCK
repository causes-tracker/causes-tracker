load("//tools:defs.bzl", "cached_check", "cached_http_archive", "tree_tool")

export_file(
    name = "pin",
    src = "BUCK",
    visibility = ["PUBLIC"],
)

tree_tool(
    name = "py",
    path = "bin/python3",
    tree = ":cpython",
    visibility = ["PUBLIC"],
)

cached_http_archive(
    name = "cpython",
    # python/install is the full interpreter tree (stdlib, headers, every
    # C extension statically linked in — lib-dynload is empty); the sibling
    # python/build is unrelated build-artifact output that paths excludes.
    paths = ["python/install"],
    sha256 = "4cf0c84dc62e08f03e9d58150bbc0be356d8e445de8722d5c6fd75397297cf46",
    size_bytes = 42628585,
    exec_compatible_with = ["//platforms:image_build_enabled"],
    strip_components = 2,
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20261013/cpython-3.15.0+20261013-x86_64-unknown-linux-musl-noopt+static-full.tar.zst"],
    visibility = ["PUBLIC"],
    zstd = "//third_party/zstd:zstd",
)

cached_check(
    name = "cpython_layout_test",
    exe = ":py",
    srcs = [
        "cpython_layout_test.py",
        ":cpython",
        ":pin",
    ],
)
