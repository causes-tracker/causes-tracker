command_alias(
    name = "py",
    exe = "//third_party/python:cpython[bin/python3]",
    visibility = ["PUBLIC"],
)

export_file(
    name = "agent_action_guard_src",
    src = "agent_action_guard.py",
)

command_alias(
    name = "agent_action_guard",
    exe = ":py",
    args = ["$(location :agent_action_guard_src)"],
    visibility = ["PUBLIC"],
)

genrule(
    name = "py_version_check",
    out = "ok.txt",
    cmd = '$(exe :py) -c "import sys; assert sys.version_info[:3] == (3, 12, 13), sys.version" && echo ok > $OUT',
)
