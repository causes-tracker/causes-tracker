load("//tools:defs.bzl", "cached_check", "cached_http_archive", "tree_tool")

export_file(
    name = "pin",
    src = "BUCK",
    visibility = ["PUBLIC"],
)

tree_tool(
    name = "py",
    path = "bin/python3",
    tree = ":cpython",
    visibility = ["PUBLIC"],
)

cached_http_archive(
    name = "cpython",
    # python/install is the full interpreter tree (stdlib, headers, every
    # C extension statically linked in — lib-dynload is empty); the sibling
    # python/build is unrelated build-artifact output that paths excludes.
    paths = ["python/install"],
    sha256 = "ac49684c0d60bd5853d0dd40c18dc8d0dd66a33284a7af22504034d0fdedc69f",
    size_bytes = 38444197,
    exec_compatible_with = ["//platforms:image_build_enabled"],
    strip_components = 2,
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260807/cpython-3.14.7+20260807-x86_64-unknown-linux-musl-noopt+static-full.tar.zst"],
    visibility = ["PUBLIC"],
    zstd = "//third_party/zstd:zstd",
)

cached_check(
    name = "cpython_layout_test",
    exe = ":py",
    srcs = [
        "cpython_layout_test.py",
        ":cpython",
        ":pin",
    ],
)
