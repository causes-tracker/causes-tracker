load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:rust.bzl", "rust_binary")
load("//tools/lint:format_check.bzl", "format_srcs")

exports_files([
    "proto_gen_impl.sh",
    "sqlx_prepare_check.sh",
    "sqlx_prepare_update.sh",
])

# Regenerates //:requirements_lock.txt.  --exclude-newer in pip_compile.sh
# enforces the same 7-day cooldown on transitives that Renovate applies to
# direct deps (see renovate.json).
sh_binary(
    name = "pip_compile",
    srcs = ["pip_compile.sh"],
    args = ["$(rootpath @uv_linux_amd64//:uv)"],
    data = ["@uv_linux_amd64//:uv"],
    visibility = ["//:__pkg__"],
)

# Render the most recent bazel coverage report as HTML and serve it.
# Usage: bazel coverage //... && bazel run //tools:show_coverage
py_binary(
    name = "show_coverage",
    srcs = ["show_coverage.py"],
    main = "show_coverage.py",
)

# Hermetic sqlx binary compiled from tools/sqlx-cli via the crate_index.
# Bazel caches and invalidates this like any other rust_binary target.
rust_binary(
    name = "sqlx_bin",
    srcs = ["sqlx-cli/src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:clap",
        "@crates//:console",
        "@crates//:sqlx",
        "@crates//:sqlx-cli",
        "@crates//:tokio",
    ],
)

# Run the hermetic sqlx binary.
# DATABASE_URL must be set (or present in .env) for migrate.
#   bazel run //tools:sqlx -- migrate run
sh_binary(
    name = "sqlx",
    srcs = ["sqlx.sh"],
    data = [
        ":sqlx_bin",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

# Run the hermetic cargo binary from the rules_rs toolchain.
# RUSTC is set to the hermetic rustc so that cargo subcommands that
# probe the toolchain (e.g. fetch, metadata) work without a host rustc
# on PATH.
#   bazel run //tools:cargo -- generate-lockfile
#   bazel run //tools:cargo -- fetch
#   bazel run //tools:cargo -- metadata
#   bazel run //tools:cargo -- tree
# For compilation (check/build/test) use: bazel build //services/...
sh_binary(
    name = "cargo",
    srcs = ["cargo.sh"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
        "@rust_host_tools//:cargo",
        "@rust_host_tools//:rustc",
    ],
)

# Run the hermetic rustc binary from the rules_rs toolchain.
# Usage: bazel run //tools:rustc -- --version
sh_binary(
    name = "rustc",
    srcs = ["rustc.sh"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
        "@rust_host_tools//:rustc",
    ],
)

# Run the hermetic rustfmt binary from the rules_rs toolchain.
# Usage: bazel run //tools:rustfmt -- --check services/causes_api/src/main.rs
#        bazel run //tools:rustfmt -- services/causes_api/src/main.rs
sh_binary(
    name = "rustfmt",
    srcs = ["rustfmt.sh"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
        "@rust_host_tools//:rustfmt",
    ],
)

# Generate Rust code from proto definitions using hermetic protoc + tonic-build.
# Usage: bazel run //tools:proto_gen
sh_binary(
    name = "proto_gen",
    srcs = ["proto_gen_impl.sh"],
    data = [
        "//proto:proto_srcs",
        "//tools/proto-gen:proto_gen",
        "@bazel_tools//tools/bash/runfiles",
        "@protobuf//:protoc",
        "@protobuf//:well_known_type_protos",
        "@rust_host_tools//:rustfmt",
    ],
)

# Golden-file staleness check.  The proto_gen binary in data is instrumented
# under `bazel coverage`, which makes collect_cc_coverage.sh try the LLVM
# profdata path.  Override GENERATE_LLVM_LCOV so it falls through to the
# gcov no-op path — there is no Rust coverage to collect from a shell test.
sh_test(
    name = "proto_gen_test",
    srcs = ["proto_gen_impl.sh"],
    args = ["--check"],
    data = [
        "//:Cargo.toml",
        "//lib/rust/causes_proto:gen_srcs",
        "//proto:proto_srcs",
        "//tools/proto-gen:proto_gen",
        "@bazel_tools//tools/bash/runfiles",
        "@protobuf//:protoc",
        "@protobuf//:well_known_type_protos",
        "@rust_host_tools//:rustfmt",
    ],
)

# Verify all three wrappers resolve and report the expected toolchain version.
# Run with: bazel test //tools:toolchain_versions_test
sh_test(
    name = "toolchain_versions_test",
    srcs = ["toolchain_versions_test.sh"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
        "@rust_host_tools//:cargo",
        "@rust_host_tools//:rustc",
        "@rust_host_tools//:rustfmt",
    ],
)

# Exercises the agent-mode suppression scanner in tools/check.sh by sourcing
# the script (with _CHECK_SH_SOURCED=1 to skip dispatch) and piping synthetic
# git-format diffs into scan_diff_for_suppressions.
sh_test(
    name = "check_scan_test",
    srcs = ["test_check_scan.sh"],
    data = [
        "check.sh",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

sh_test(
    name = "update_archive_sha_test",
    srcs = ["renovate/update_archive_sha_test.sh"],
    data = [
        "renovate/update_archive_sha.sh",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

sh_test(
    name = "update_sha_test",
    srcs = ["renovate/update_sha_test.sh"],
    data = [
        "renovate/update_sha.sh",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

sh_test(
    name = "install_release_test",
    srcs = ["install_release_test.sh"],
    data = [
        "install_release.shlib",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

# PreToolUse action guard, wired into .claude/settings.json.  Denies forbidden
# agent actions at the moment of action: native tooling instead of the Bazel
# wrappers, lockfile destruction, and mod.rs creation.  Decision logic lives in
# decide() so it is unit-testable without spawning a subprocess.
py_library(
    name = "agent_action_guard",
    srcs = ["agent_action_guard.py"],
    imports = ["."],
)

py_test(
    name = "agent_action_guard_test",
    size = "small",
    srcs = ["agent_action_guard_test.py"],
    data = [
        "cargo.sh",
        "proto_gen_impl.sh",
        "rustc.sh",
        "rustfmt.sh",
        "sqlx.sh",
        "sqlx_prepare_check.sh",
        "sqlx_prepare_update.sh",
        "toolchain_versions_test.sh",
    ],
    main = "agent_action_guard_test.py",
    deps = [":agent_action_guard"],
)

format_srcs()
