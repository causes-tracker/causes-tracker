# shellcheck configuration for the buck2 shellcheck_check targets.
# See https://www.shellcheck.net/wiki/Directive for rule IDs.
# Each script's shebang selects its dialect; a sourced file without one
# carries a `# shellcheck shell=` directive.

# Follow sourced files (they are staged as check inputs), resolving
# `source=` annotations relative to the sourcing script.
external-sources=true
source-path=SCRIPTDIR
