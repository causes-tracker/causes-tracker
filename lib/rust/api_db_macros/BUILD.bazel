load("//build:rust.bzl", "rust_proc_macro")
load("//tools/lint:format_check.bzl", "format_srcs")

rust_proc_macro(
    name = "api_db_macros",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:proc-macro2",
        "@crates//:quote",
        "@crates//:syn",
    ],
)

# Filegroup of the crate's source + Cargo.toml — consumed by sibling crates'
# sqlx_prepare_test via the `path_deps` parameter of //tools:sqlx_prepare.bzl.
filegroup(
    name = "all_srcs",
    srcs = ["Cargo.toml"] + glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)

format_srcs()
